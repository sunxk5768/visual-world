{
  "manifest_version": 3,
  "name": "视界",
  "version": "0.9.3",
  "description": "SXKUNIANGAI：抓取当前页面的视频，在对比面板中同步回放。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "抓取视频并打开同步预览",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "file:///*"
  ]
}
